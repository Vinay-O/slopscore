{
  "name": "slopscore",
  "version": "2.4.0",
  "description": "Scan your codebase for AI slop, get a Slop Score, ship clean. Zero runtime dependencies. 189 detectors (security, robustness, performance, code quality, design tells) + a 285-pattern Anti-Slop Protocol for AI coding agents. Optional --ast mode for real complexity metrics.",
  "bin": {
    "slopscore": "bin/slopscore.js"
  },
  "type": "commonjs",
  "scripts": {
    "test": "node --test",
    "scan": "node bin/slopscore.js scan .",
    "selfcheck": "node bin/slopscore.js scan . --fail-on minor",
    "bench": "node scripts/benchmark.js",
    "pr": "node scripts/precision-recall.js",
    "teardown": "node scripts/scan-repos.js",
    "demo": "node bin/slopscore.js scan examples/slop.tsx"
  },
  "files": [
    "bin/",
    "src/",
    "ANTI_SLOP_PROTOCOL.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai-slop",
    "vibe-coding",
    "code-quality",
    "linter",
    "static-analysis",
    "security",
    "ai-generated-code",
    "code-review",
    "claude-code",
    "cursor",
    "slop"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "homepage": "https://github.com/Vinay-O/slopscore#readme",
  "bugs": {
    "url": "https://github.com/Vinay-O/slopscore/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vinay-O/slopscore.git"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.4",
    "acorn": "^8.17.0"
  },
  "peerDependencies": {
    "acorn": ">=8",
    "@babel/parser": ">=7"
  },
  "peerDependenciesMeta": {
    "acorn": {
      "optional": true
    },
    "@babel/parser": {
      "optional": true
    }
  }
}
